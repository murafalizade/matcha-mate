{
    "cli": {
        "version": ">= 13.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "preview": {
            "distribution": "internal",
            "env": { "EXPO_PUBLIC_API_URL": "https://social-coffee-api.fly.dev" }
        },
        "production": { "env": { "EXPO_PUBLIC_API_URL": "https://social-coffee-api.fly.dev" } }
    },
    "submit": {
        "production": {}
    }
}
